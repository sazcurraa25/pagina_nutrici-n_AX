# ─────────────────────────────────────────────────────────────
# Copiá este archivo como .env.local y completá los valores.
# Vercel: Project Settings → Environment Variables.
# Netlify: Site settings → Environment variables.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com.ar

# Proveedor de turnos:
#   mock   → modo demo, disponibilidad simulada, sin credenciales (por defecto)
#   google → UI propia + Google Calendar API (recomendado)
#   calcom → agenda embebida de Cal.com
BOOKING_PROVIDER=mock

# Secreto para firmar los links de cancelación (mínimo 32 caracteres, aleatorio).
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_SECRET=

# Mostrar la sección "Historias de pacientes" (true/false).
# Requiere autorización previa del Colegio de Nutricionistas antes de publicarla (ver README).
SHOW_STORIES=true

# ── Google Calendar (BOOKING_PROVIDER=google) ────────────────
# Credenciales OAuth 2.0 (tipo "Aplicación web") del proyecto de Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene una sola vez con:  npm run google:token
GOOGLE_REFRESH_TOKEN=
# ID del calendario donde se crean los turnos ("primary" = calendario principal de la cuenta).
GOOGLE_CALENDAR_ID=primary
# (Opcional) Otros calendarios de la misma cuenta que también bloquean turnos cuando están ocupados,
# separados por coma. Ej.: un calendario personal o de otro consultorio.
GOOGLE_BUSY_CALENDAR_IDS=
# (Opcional) Puerto local que usa  npm run google:token  (por defecto 53682).
# Si lo cambiás, actualizá también la URI de redirección autorizada en Google Cloud.
OAUTH_PORT=53682

# ── Cal.com (BOOKING_PROVIDER=calcom) ────────────────────────
# Usuario/evento de Cal.com, ej.: "lic-nombre/primera-consulta"
NEXT_PUBLIC_CALCOM_LINK=

# ── Cloudflare Turnstile (anti-spam, gratis) ─────────────────
# https://dash.cloudflare.com → Turnstile.
# OBLIGATORIAS en producción con BOOKING_PROVIDER=google (si no, las reservas fallan a propósito).
# Configurá SIEMPRE las dos juntas: una sola también hace fallar las reservas.
# En desarrollo o en modo demo (mock) se pueden dejar vacías y se omite la verificación.
# Claves de prueba que siempre validan:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analítica (sin cookies) ──────────────────────────────────
# En Vercel se usa Vercel Analytics (se activa solo con el deploy, no necesita variable).
# En Netlify u otro host, configurá tu dominio de Plausible para activarlo (ej.: tu-dominio.com.ar).
# Se dejan afuera las rutas /turno/cancelar/* para no registrar los tokens de cancelación.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
